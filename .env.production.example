APP_AUTH_COOKIE_NAME=ovoshi_help_session
# Copy to a secret-backed environment file outside version control and replace every placeholder.
APP_CORS_ALLOWED_ORIGINS=https://shop.example.com
# Canonical public origin for sitemap and server-rendered pages (no trailing path).
APP_SEO_SITE_URL=https://shop.example.com
# Optional verification codes copied from Google Search Console / Yandex Webmaster.
APP_SEO_GOOGLE_SITE_VERIFICATION=
APP_SEO_YANDEX_VERIFICATION=
POSTGRES_DB=company_shop
POSTGRES_USER=company_shop
POSTGRES_PASSWORD=
APP_BOOTSTRAP_ADMIN_PASSWORD=
MINIO_ROOT_USER=company-shop
MINIO_ROOT_PASSWORD=
APP_STORAGE_BUCKET=company-shop-files

# Optional runtime tuning.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
ALIBABA_SOURCING_PROVIDER=html
# Backend-only GPT access. Put the real key only in .env.production on the server.
APP_GPT_ENABLED=false
APP_GPT_MODEL=gpt-6-luna
APP_GPT_REASONING_EFFORT=medium
OPENAI_API_KEY=

# WhatsApp Cloud API. Store real values only in the server's secret-backed environment.
APP_WHATSAPP_ACCESS_TOKEN=
APP_WHATSAPP_PHONE_NUMBER_ID=
APP_WHATSAPP_WABA_ID=
APP_WHATSAPP_VERIFY_TOKEN=
APP_WHATSAPP_APP_SECRET=
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Web Push: generate one persistent VAPID key pair; keep the private key server-side.
APP_WEB_PUSH_PUBLIC_KEY=
APP_WEB_PUSH_PRIVATE_KEY=
APP_WEB_PUSH_SUBJECT=

# MKS supplier catalog test. Backend only; leave empty until configured.
APP_MKS_LOGIN=
APP_MKS_PASSWORD=
