{
	default_sni {$LAN_HOST:localhost}
	auto_https disable_redirects
}

(ovoshi_routes) {
	encode zstd gzip

	@legacyProduct path_regexp legacyProduct ^/p[0-9]+(-[^/]+)?\.html$
	handle @legacyProduct {
		reverse_proxy backend:8080
	}

	@backend path /api/* /uploads/* / /catalog /catalog/* /categories /product/* /robots.txt /sitemap.xml /sitemap-*.xml /swagger-ui* /swagger-ui/* /v3/api-docs* /v3/api-docs/*
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:{$FRONTEND_PORT:5175}
	}
}

http://{$LAN_HOST:localhost} {
	import ovoshi_routes
}

https://{$LAN_HOST:localhost} {
	tls internal
	import ovoshi_routes
}
