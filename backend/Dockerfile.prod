FROM maven:3.9.9-eclipse-temurin-21 AS dependencies

WORKDIR /workspace
COPY pom.xml ./
RUN mvn -B -ntp dependency:go-offline

FROM dependencies AS build

COPY src ./src
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre-jammy AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/price-importer-venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY price-importer/requirements.txt /tmp/price-importer-requirements.txt
RUN python3 -m venv /opt/price-importer-venv \
    && /opt/price-importer-venv/bin/pip install --no-cache-dir -r /tmp/price-importer-requirements.txt \
    && rm /tmp/price-importer-requirements.txt

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app \
    && install -d -o app -g app /tmp/company-shop-price-imports

WORKDIR /app
COPY --from=build --chown=app:app /workspace/target/company-shop-backend-*.jar ./app.jar
COPY --chown=app:app price-importer/price_importer.py ./price-importer/price_importer.py

USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
