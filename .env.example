# Separate local development stack. All published ports bind to 127.0.0.1.
LAN_HOST=localhost
FRONTEND_PORT=5175
BACKEND_PORT=8084
POSTGRES_PORT=5434
EMBEDDING_PORT=8002
GATEWAY_HTTP_PORT=8085
GATEWAY_HTTPS_PORT=8445
APP_AUTH_COOKIE_NAME=ovoshi_help_session
APP_CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:8085,http://127.0.0.1:8085,https://localhost:8445

# Optional local rotation of the public migration seed password.
APP_ROTATE_SEED_ADMIN=false
APP_BOOTSTRAP_ADMIN_PASSWORD=

# GPT provider (disabled until a server-side API key is configured).
APP_GPT_ENABLED=false
APP_GPT_MODEL=gpt-6-luna
APP_GPT_REASONING_EFFORT=medium
OPENAI_API_KEY=

# WhatsApp Cloud API. Leave empty until a Meta business number and webhook are configured.
APP_WHATSAPP_ACCESS_TOKEN=
APP_WHATSAPP_PHONE_NUMBER_ID=
APP_WHATSAPP_WABA_ID=
APP_WHATSAPP_VERIFY_TOKEN=
APP_WHATSAPP_APP_SECRET=

# Web Push: generate one persistent VAPID key pair; keep the private key server-side.
APP_WEB_PUSH_PUBLIC_KEY=
APP_WEB_PUSH_PRIVATE_KEY=
APP_WEB_PUSH_SUBJECT=

# MKS supplier catalog test. Backend only; leave empty until configured.
APP_MKS_LOGIN=
APP_MKS_PASSWORD=
